# Optional: copy to .env to override the defaults. docker compose reads .env from the repository
# root and already falls back to these same values, so it runs without one.

# Database (PostGIS container)
POSTGRES_DB=lotline
POSTGRES_USER=lotline
POSTGRES_PASSWORD=lotline
POSTGRES_PORT=5432

# Port of the app (nginx serving the SPA and proxying /api) in docker compose
WEB_PORT=8080

# API datasource (used by ./gradlew bootRun; compose points DB_URL at the db service)
DB_URL=jdbc:postgresql://localhost:5432/lotline
DB_USER=lotline
DB_PASSWORD=lotline
