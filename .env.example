# Copy to .env and adjust. docker compose reads .env from the repository root.

# Database (PostGIS container)
POSTGRES_DB=lotline
POSTGRES_USER=lotline
POSTGRES_PASSWORD=lotline
POSTGRES_PORT=5432

# API datasource (used by ./gradlew bootRun; compose points DB_URL at the db service)
DB_URL=jdbc:postgresql://localhost:5432/lotline
DB_USER=lotline
DB_PASSWORD=lotline
